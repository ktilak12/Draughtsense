# Git and version control
**/.git
**/.gitignore

# Development and IDE
**/.vscode
**/.idea
**/*.swp
**/*.swo

# Python artifacts
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node and frontend
**/node_modules
frontend/dist

# Databases & local persistent storage
backend/*.db
backend/*.sqlite3
backend/uploads/*
!backend/uploads/.gitkeep

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
